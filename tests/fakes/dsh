#!/usr/bin/env bash
# Stand-in for the dsh CLI: records its arguments, prints the web URL line like the real web app
# and stays up until signalled. The process keeps "dsh" in its command line, as the launcher expects.
printf '%s\n' "$*" >> "${FAKE_DSH_LOG:?}"

port=3080
while [[ $# -gt 0 ]]; do
  case "$1" in
    --port) port="$2"; shift ;;
    --dump-config) echo "fake dump-config"; exit 0 ;;
  esac
  shift
done

echo "dsh web: http://127.0.0.1:$port/?token=fake-token"
while :; do sleep 1; done
