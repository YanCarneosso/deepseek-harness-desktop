# deepseek-harness-desktop launcher preferences.
# install.sh copies this file to ~/.config/deepseek-harness-desktop/launcher.env; edit it there.

# Workspace opened from the application menu (you can switch folders inside the app).
DSH_DESKTOP_WORKSPACE="$HOME"

# First port tried; each folder open at the same time takes the next free one.
DSH_DESKTOP_FIRST_PORT=3080

# Seconds to wait for the interface (the very first start, which sets up the profile, is the slowest).
DSH_DESKTOP_START_TIMEOUT=120

# 1 = standalone app window (Chromium --app, isolated profile); 0 = tab in the default browser.
DSH_DESKTOP_APP_MODE=1

# Browser for app mode. Empty = first found: chromium, google-chrome-stable, brave, vivaldi, edge.
DSH_DESKTOP_BROWSER=""

# 1 = closing the window stops the server it started (instances opened by VS Code/terminal keep running).
DSH_DESKTOP_STOP_ON_CLOSE=1

# Host used in the app window URL; it names the window on Wayland. Must resolve to loopback.
DSH_DESKTOP_APP_HOST="dsh.localhost"

# Optional command that prints your DeepSeek API key (used when DEEPSEEK_API_KEY is unset).
# Without it, dsh uses ~/.dsh/.env or the credential saved in Settings -> Models.
# Example: DSH_DESKTOP_KEY_COMMAND="pass show deepseek/api-key"
DSH_DESKTOP_KEY_COMMAND=""

# Disables dsh telemetry. Comment out to allow it.
export DSH_TELEMETRY_DISABLED=1
